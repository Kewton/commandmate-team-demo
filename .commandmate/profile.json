{
  "id": "node-team-demo",
  "repository": "Kewton/commandmate-team-demo",
  "base": "origin/develop",
  "branch_template": "feature/issue-{number}-{slug}",
  "worktree_template": "../{repo}-issue-{number}-{slug}",
  "baseline": [
    "npm ci",
    "npm test"
  ],
  "verified": true,
  "scope_companions": {
    "derive": []
  },
  "dispatch_defaults": {
    "auto_yes": true,
    "wait_timeout": 600,
    "max_turns": 8
  }
}
